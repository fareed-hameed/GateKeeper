# GateKeeper Configuration
# Copy this file to config.yaml and fill in your values.
# config.yaml is gitignored — secrets never leave your server.

# Protected Action
# The URL that gets called when a valid code is entered.
# Examples: IoT trigger, smart home webhook, API endpoint
action_url: "https://your-api-endpoint.com/trigger"
action_timeout_seconds: 10
action_method: "GET"        # GET or POST
action_label: "Trigger"     # Label shown to users on success/failure

# Daily Code
# A secret used to deterministically generate the daily code.
# Change this to any random string — the longer the better.
code_secret: "change-me-to-a-random-string"
code_length: 6              # Number of digits in the daily code

# Rate Limiting
max_opens_per_device: 3     # Max successful triggers per device per day
access_window_minutes: 15   # Minutes from first successful trigger
daily_reset_hour: 3         # Hour (0-23) when daily counters reset (in your timezone)
timezone_offset_hours: 3    # GMT offset (e.g. 3 for GMT+3, -5 for EST)

# Cooldown
cooldown_seconds: 15        # Min seconds between triggers (code users)

# Trusted Device Rules (enrolled/bypass devices)
trusted_max_opens: 50       # Max triggers per trusted device per day
trusted_cooldown_seconds: 15 # Min seconds between bypass triggers

# Admin
# One-time PIN required to enroll a new admin device.
master_pin: "change-me"

# Server
port: 5000
debug: false
